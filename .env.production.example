# Copy to .env and replace every change-me value before using compose.release.yaml.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-database-password
REDIS_PASSWORD=change-me-redis-password

ATLAS_SECRET_KEY=change-me-use-at-least-32-random-characters
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:change-me-database-password@db:5432/atlas
ATLAS_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
ATLAS_CORS_ORIGINS=["https://atlas.example.com"]
ATLAS_TRUSTED_HOSTS=["atlas.example.com"]
ATLAS_WEB_PORT=8080
